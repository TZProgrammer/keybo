  "Q2_would_it_have_caught_the_misreadings": {
    "ledger_11919_and_12013": {
      "claim": "per-fold pooled 0.914-0.999 ... the surface does not compress",
      "measured_full_range_over_12_cells": [
        0.9138484672612666,
        1.2355506583668359
      ],
      "measured_range_excluding_qwerty": [
        0.9138484672612666,
        0.9992898715598655
      ],
      "would_artifact_contradict_it": "YES, decisively. An always-emitted per-fold gate block makes fold-omission visible: you cannot quote a range over 3 of 4 folds when the 4th fold's block sits in the same artifact with passed=False."
    },
    "ledger_356": {
      "claim": "both champions hold tau +1.0 with calibration slopes ~1.0 per fold",
      "measured_pooled_per_fold": {
        "azerty": 0.9976801588216291,
        "dvorak": 0.9188914304408767,
        "qwerty": 1.228325645798299,
        "qwertz": 0.9633754527313892
      },
      "would_artifact_contradict_it": "YES for the qwerty fold at pooled 1.2283 and bucket_centered 1.4067; '~1.0 per fold' is false of 1 of 4 folds and the artifact would say passed=False on it."
    },
    "ledger_98": {
      "bigram_qwerty_bucket_centered_measured": [
        1.4144924536442705,
        1.394499910935851,
        1.4112026522784331
      ],
      "bigram_qwerty_pooled_measured": [
        1.2355506583668359,
        1.2198889873046905,
        1.2295372917233702
      ],
      "claim": "calibration slope 1.04 on qwerty (no compression)",
      "is_about": "the TRIGRAM model (runs/lolo_trigram_v1.json), a different artifact/model",
      "would_artifact_contradict_it": "NOT DIRECTLY -- it is a trigram claim and I did not re-run the trigram LOLO. But the gate emits passed=False per fold-seed, so the WORD 'no compression' could not have been written beside a passed=False block without the contradiction being visible in the same file."
    }
